public class carro {

    String nome;
    String marca;
    int ano;
    int velocidade;

    void acelerar(int aceleracao) {
        velocidade += aceleracao;
    }
    void frear(int reduzir){
        velocidade -= reduzir;
    }
    void buzinar(){
        System.out.println("bibibi");
    }
}
    public class teste {
    //instanciando o objeto
    public static void main(String[] args) {
        carro c1 = new carro();
        c1.nome = "Uno";
        c1.marca = "Fiat";
        c1.ano = 2015;
        c1.velocidade = 60;

        c1.acelerar(10);
        System.out.println("Velocidade: " + c1.velocidade + " km/h" );

        c1.frear(30);
        System.out.println("Velocidade: " + c1.velocidade + " km/h" );
    }
